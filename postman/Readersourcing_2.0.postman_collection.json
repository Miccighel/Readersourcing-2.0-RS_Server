      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{host}}/logout.json",
        "description": "Logs out the current reader session and revokes the JWT stored by that session. After a successful response, the request script also removes `authToken` from the collection variables. Tokens associated with the reader's other sessions remain valid."
      },
      "response": [],
      "_postman_id": "af59176f-cd04-484f-a082-42b6b1b6e13a",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.unset(\"authToken\");",
              "}"
            ]
          }
        }
      ]
