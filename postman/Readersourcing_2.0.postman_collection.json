{
  "info": {
    "_postman_id": "7a08a897-9075-42e1-be30-5cc01b85cb54",
    "name": "Readersourcing 2.0",
    "description": "<html><head></head><body><p>This is the official API collection of the <strong>Readersourcing 2.0 ecosystem</strong> presented during the <a href=\"https://ircdl2019.isti.cnr.it/\">IRCDL 2019</a> conference. The original article can be freely read on <a href=\"https://zenodo.org/record/1446468\">Zenodo</a>, while the code and the related documentation is available on <strong>GitHub</strong>. Take advantage of the badges below to exploit these resources.</p>\n<p><a href=\"https://ircdl2019.isti.cnr.it/\"><img src=\"https://img.shields.io/badge/IRCDL%202019-Conference-yellow.svg\"></a>\n<a href=\"https://doi.org/10.5281/zenodo.1446468\"><img src=\"https://img.shields.io/badge/Zenodo-Paper-blue.svg\"></a>\n<a href=\"https://github.com/Miccighel/Readersourcing-2.0\"><img src=\"https://img.shields.io/badge/GitHub-Code-lightgrey.svg\"></a></p>\n</body></html>",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication (Authenticate)",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "38338bc1-abc3-4b19-84d5-f8e870653ea0",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const response = pm.response.json();",
              "  if (response.auth_token) {",
              "    pm.collectionVariables.set(\"authToken\", response.auth_token);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "id": "796f030b-ea08-4bad-a3a5-3c70ee6f15b8",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{host}}/authenticate.json",
        "description": "Authenticates an API client and returns a JWT. The request script stores the token in the authToken collection variable."
      },
      "response": [],
      "_postman_id": "796f030b-ea08-4bad-a3a5-3c70ee6f15b8"
    },
