#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
	echo "Usage: bin/backup BACKUP_DIRECTORY" >&2
	exit 64
fi

backup_parent=$1
case "$backup_parent" in
	""|"/")
		echo "Refusing an empty or root backup directory." >&2
		exit 64
		;;
esac

mkdir -p "$backup_parent"
backup_parent=$(cd "$backup_parent" && pwd -P)
timestamp=$(date -u "+%Y%m%dT%H%M%SZ")
backup_directory="$backup_parent/rs_server_$timestamp"

if [ -e "$backup_directory" ]; then
	echo "Backup directory already exists: $backup_directory" >&2
	exit 73
fi

umask 077
mkdir "$backup_directory"

database_container=$(docker compose ps --status running --quiet database)
web_container=$(docker compose ps --status running --quiet rs_server_webapp)
if [ -z "$database_container" ] || [ -z "$web_container" ]; then
	echo "The database and RS_Server containers must both be running." >&2
	exit 69
fi

docker compose exec -T database sh -c \
	'exec pg_dump --format=custom --no-owner --no-privileges --username="$POSTGRES_USER" "$POSTGRES_DB"' \
	> "$backup_directory/database.dump"

docker compose exec -T rs_server_webapp \
	tar -C /rs_server/storage/publications/user -czf - . \
	> "$backup_directory/publications.tar.gz"

(
	cd "$backup_directory"
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum database.dump publications.tar.gz > SHA256SUMS
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 database.dump publications.tar.gz > SHA256SUMS
	else
		echo "A SHA256 checksum command is required." >&2
		exit 69
	fi
)

image=$(docker inspect --format '{{.Config.Image}}' "$web_container")
{
	echo "created_at=$timestamp"
	echo "application_image=$image"
} > "$backup_directory/manifest.txt"

echo "Backup completed: $backup_directory"
