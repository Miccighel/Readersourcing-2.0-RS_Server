#!/bin/sh
set -eu
umask 077
test "$(id -u)" = 0
test "$#" -ge 1
case "$1" in
  check|start|restart) test "$#" -eq 1 ;;
  restore-rehearsal) test "$#" -eq 2 && test "$2" = --confirm-isolated-restore ;;
  *) exit 64 ;;
esac
rs_operations_directory=/opt/readersourcing/rs-server
for rs_directory in /opt/readersourcing "$rs_operations_directory"; do
  test -d "$rs_directory" && test ! -L "$rs_directory"
  test "$(stat -c '%u:%a' "$rs_directory")" = 0:755
done
test "$(stat -c '%u:%a' /etc/opt/readersourcing)" = 0:700
test "$(stat -c '%u:%a' /etc/opt/readersourcing/rs-server)" = 0:700
test -f /etc/opt/readersourcing/rs-server/context.sh
test ! -L /etc/opt/readersourcing/rs-server/context.sh
test "$(stat -c '%u:%a' /etc/opt/readersourcing/rs-server/context.sh)" = 0:600
(cd "$rs_operations_directory" && sha256sum --check --status OPERATIONS-SHA256SUMS)
. /etc/opt/readersourcing/rs-server/context.sh
. "$rs_operations_directory/candidate_restart.sh"
. "$rs_operations_directory/candidate_startup.sh"
. "$rs_operations_directory/deployment_operations.sh"
if [ "$1" = restore-rehearsal ]; then
  . "$rs_operations_directory/recovery_rehearsal.sh"
  . "$rs_operations_directory/deployment_recovery.sh"
  deployment_recovery_main "$2"
else
  deployment_operations_main "$@"
fi
