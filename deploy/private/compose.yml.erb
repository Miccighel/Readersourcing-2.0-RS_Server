name: <%= project_name %>

x-logging: &logging
  driver: local
  options:
    max-size: "2m"
    max-file: "2"

x-app: &app
  image: <%= application_image %>
  runtime: runc
  networks: [default]
  env_file: ./runtime/application.env
  environment:
    RAILS_ENV: production
    PUBLIC_BASE_URL: http://127.0.0.1:33030
    CORS_ALLOWED_ORIGINS: http://127.0.0.1:33030
    FORCE_SSL: "false"
    ASSUME_SSL: "false"
    RS_PDF_ALLOW_PRIVATE_NETWORKS: "false"
    POSTGRES_HOST: database
    SMTP_DOMAIN_ADDRESS: mailpit
    SSL_CERT_FILE: /trial/smtp.crt
  read_only: true
  init: true
  restart: "no"
  cpus: 1.0
  mem_limit: 1g
  pids_limit: 256
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  tmpfs:
    - /tmp:rw,noexec,nosuid,size=64m,mode=1777
    - /rs_server/tmp:rw,noexec,nosuid,size=64m,uid=1000,gid=1000,mode=0755
    - /rs_server/log:rw,noexec,nosuid,size=64m,uid=1000,gid=1000,mode=0755
  volumes:
    - publications:/rs_server/storage/publications/user
    - ./runtime/smtp.crt:/trial/smtp.crt:ro
  logging: *logging

services:
  database:
    image: postgres:17
    runtime: runc
    networks: [default]
    env_file: ./runtime/database.env
    restart: "no"
    cpus: 0.5
    mem_limit: 512m
    pids_limit: 128
    security_opt: [no-new-privileges:true]
    volumes:
      - database:/var/lib/postgresql/data
    healthcheck:
      test: [CMD-SHELL, pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB]
      interval: 5s
      timeout: 3s
      retries: 30
    logging: *logging

  mailpit:
    image: axllent/mailpit:v1.31.5
    runtime: runc
    networks: [default]
    user: "<%= uid %>:<%= gid %>"
    env_file: ./runtime/mailpit.env
    restart: "no"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    cpus: 0.25
    mem_limit: 128m
    pids_limit: 64
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m,mode=1777
    volumes:
      - ./runtime/smtp.crt:/trial/smtp.crt:ro
      - ./runtime/smtp.key:/trial/smtp.key:ro
      - ./runtime/smtp.auth:/trial/smtp.auth:ro
      - ./runtime/ui.auth:/trial/ui.auth:ro
    logging: *logging

  access:
    image: nginx:1.30.5-alpine
    runtime: runc
    user: "<%= uid %>:<%= gid %>"
    networks: [access, default]
    entrypoint: [nginx]
    command: [-e, stderr, -c, /trial/proxy.conf, -g, "daemon off;"]
    restart: "no"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    cpus: 0.25
    mem_limit: 64m
    pids_limit: 32
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m,mode=1777
    volumes:
      - ./runtime/proxy.conf:/trial/proxy.conf:ro
    ports:
      - "127.0.0.1:33030:8080"
      - "127.0.0.1:33031:8081"
    depends_on:
      rs_server_webapp: {condition: service_healthy}
      mailpit: {condition: service_started}
    healthcheck:
      test: [CMD, wget, -q, -O, /dev/null, "http://127.0.0.1:8080/login"]
      interval: 5s
      timeout: 5s
      retries: 10
    logging: *logging

  rs_server_setup:
    <<: *app
    command: [./bin/rails, db:migrate]
    depends_on:
      database: {condition: service_healthy}

  rs_server_webapp:
    <<: *app
    stop_grace_period: 30s
    depends_on:
      database: {condition: service_healthy}
      mailpit: {condition: service_started}
      rs_server_setup: {condition: service_completed_successfully}
    healthcheck:
      test: [CMD, ruby, -rnet/http, -e, "exit(Net::HTTP.get_response(URI('http://127.0.0.1:3000/ready')).is_a?(Net::HTTPSuccess) ? 0 : 1)"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 20s

networks:
  default:
    driver: bridge
    internal: true
    driver_opts:
      com.docker.network.bridge.gateway_mode_ipv4: isolated
  access:
    driver: bridge
    driver_opts:
      com.docker.network.bridge.host_binding_ipv4: "127.0.0.1"

volumes:
  database:
  publications:
