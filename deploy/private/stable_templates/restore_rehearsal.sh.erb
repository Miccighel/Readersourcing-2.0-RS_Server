#!/bin/sh
set -eu
umask 077
test "$(id -u)" = 0
test "$#" -eq 1
test "$1" = --confirm-isolated-restore
rs_operations_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
test "$rs_operations_directory" = <%= shell("installation_root") %>/operations
test "$(stat -c '%u:%a' "$rs_operations_directory")" = 0:700
. "$rs_operations_directory/context.sh"
test "$(stat -c '%u:%a' "$rs_backup_directory")" = 0:700
grep -Fxq "source_project=$rs_expected_project" "$rs_backup_directory/manifest.txt"
grep -Fxq "application_image_id=$rs_backup_image" "$rs_backup_directory/manifest.txt"
. "$rs_operations_directory/recovery_rehearsal.sh"
recovery_main "$@"
