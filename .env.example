# Rails secrets. Generate each value with `bin/rails secret`.
SECRET_DEV_KEY=replace_with_a_development_secret
SECRET_PROD_KEY=replace_with_a_production_secret

# PostgreSQL. Docker Compose replaces POSTGRES_HOST with `database` for RS_Server.
POSTGRES_USER=rs_server
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=rs_server
POSTGRES_TEST_DB=rs_server_test
POSTGRES_HOST=localhost
# A complete DATABASE_URL may replace the individual PostgreSQL values.
# DATABASE_URL=postgresql://user:password@host/database
# TEST_DATABASE_URL=postgresql://user:password@host/test_database

# Public application origin and browser access policy.
PUBLIC_BASE_URL=https://readersourcing.example
ADDITIONAL_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=https://readersourcing.example
FORCE_SSL=true
# Set this to true only when every request reaches Rails through an HTTPS terminating proxy.
ASSUME_SSL=false

# Mail delivery and contact destinations.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN_NAME=
SMTP_DOMAIN_ADDRESS=
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_OPEN_TIMEOUT=5
SMTP_READ_TIMEOUT=10
EMAIL_BUG_REPORT=
EMAIL_ADMIN=

# Public privacy policy and operational retention.
PRIVACY_CONTROLLER_NAME=replace_with_the_data_controller_name
PRIVACY_HOSTING_PROVIDER=replace_with_the_hosting_provider
PRIVACY_HOSTING_COUNTRY=replace_with_the_hosting_country
PRIVACY_EMAIL_PROVIDER=replace_with_the_email_provider
PRIVACY_EMAIL_PROVIDER_COUNTRY=replace_with_the_email_provider_country
PRIVACY_LOG_RETENTION_DAYS=30
PRIVACY_BACKUP_RETENTION_DAYS=30

# Production process settings.
RAILS_LOG_TO_STDOUT=1
RAILS_MAX_THREADS=5
RS_SERVER_BIND_ADDRESS=127.0.0.1
RS_SERVER_PORT=3000
RS_SERVER_CPU_LIMIT=1.0
RS_SERVER_MEMORY_LIMIT=1g
RS_SERVER_PID_LIMIT=256
RS_DATABASE_CPU_LIMIT=1.0
RS_DATABASE_MEMORY_LIMIT=512m
RS_DATABASE_PID_LIMIT=128
RS_LOG_MAX_SIZE=10m
RS_LOG_MAX_FILES=5

# PDF preparation limits.
RS_PDF_MAX_DOWNLOAD_BYTES=52428800
RS_PDF_OPEN_TIMEOUT=5
RS_PDF_READ_TIMEOUT=20
RS_PDF_PROCESS_TIMEOUT=60
RS_PDF_ALLOW_PRIVATE_NETWORKS=false
RS_PDF_STORAGE_ROOT=
RS_PDF_DOWNLOAD_URL_TTL=300

# Request limits.
RS_AUTHENTICATION_RATE_LIMIT=10
RS_PASSWORD_RECOVERY_IP_RATE_LIMIT=5
RS_PASSWORD_RECOVERY_ACCOUNT_RATE_LIMIT=3
RS_CONTACT_RATE_LIMIT=5
RS_PDF_PROCESSING_RATE_LIMIT=30
